  background-size: 100% 100%;
  background-repeat:no-repeat;
  border:none;
  border-radius: 0;
}
.start-ui{
  display: flex;
  margin-left: 142rpx;
  margin-top: 18rpx;
  animation: heartbeat-data 1.5s infinite;
}
.start-button  .start-ui .txt{
  width:329rpx;
  height:115rpx;
}
.rule-button{
  width: 138rpx;
  height: 30rpx;
  padding:0;
  left: 325rpx;
  top: 1404rpx;
  margin: auto;
  border:none;
  border-radius: 0;
  background: rgba(255,204,51, 0);
}
.rule-button  .txt{
