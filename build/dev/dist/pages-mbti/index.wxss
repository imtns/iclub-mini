.heartbeat {
  -webkit-animation: heartbeat-data 1.5s infinite;
          animation: heartbeat-data 1.5s infinite;
}
.page {
  position: relative;
}
.page .title {
  display: flex;
  position: absolute;
}
@-webkit-keyframes heartbeat-data {
0% {
    -webkit-transform: scale(0.95);
            transform: scale(0.95);
}
50% {
    -webkit-transform: scale(1);
            transform: scale(1);
}
100% {
    -webkit-transform: scale(0.95);
            transform: scale(0.95);
}
}
@keyframes heartbeat-data {
0% {
    -webkit-transform: scale(0.95);
            transform: scale(0.95);
}
50% {
    -webkit-transform: scale(1);
            transform: scale(1);
}
100% {
    -webkit-transform: scale(0.95);
            transform: scale(0.95);
}
}
.heartbeat2 {
  -webkit-animation: heartbeat-data2 1.5s infinite;
          animation: heartbeat-data2 1.5s infinite;
}
@-webkit-keyframes heartbeat-data2 {
0% {
    -webkit-transform: scale(1.05);
            transform: scale(1.05);
}
50% {
    -webkit-transform: scale(1);
            transform: scale(1);
}
100% {
    -webkit-transform: scale(1.05);
            transform: scale(1.05);
}
}
@keyframes heartbeat-data2 {
0% {
    -webkit-transform: scale(1.05);
            transform: scale(1.05);
}
50% {
    -webkit-transform: scale(1);
            transform: scale(1);
}
100% {
    -webkit-transform: scale(1.05);
            transform: scale(1.05);
}
}
.light {
  -webkit-animation: light-data 1.5s infinite;
          animation: light-data 1.5s infinite;
}
@-webkit-keyframes light-data {
0% {
    box-shadow: 10rpx 10rpx 20rpx #F2F0EE;
}
50% {
    box-shadow: 10rpx 10rpx 20rpx #F2F0EE;
}
100% {
    box-shadow: 10rpx 10rpx 20rpx #F2F0EE;
}
}
@keyframes light-data {
0% {
    box-shadow: 10rpx 10rpx 20rpx #F2F0EE;
}
50% {
    box-shadow: 10rpx 10rpx 20rpx #F2F0EE;
}
100% {
    box-shadow: 10rpx 10rpx 20rpx #F2F0EE;
}
}
.alpha {
  -webkit-animation: alpha-data 1.5s infinite;
          animation: alpha-data 1.5s infinite;
}
@-webkit-keyframes alpha-data {
0% {
    opacity: 0;
}
50% {
    opacity: 1;
}
100% {
    opacity: 0;
}
}
@keyframes alpha-data {
0% {
    opacity: 0;
}
50% {
    opacity: 1;
}
100% {
    opacity: 0;
}
}
.alpha2 {
  -webkit-animation: alpha-data2 1.5s infinite;
          animation: alpha-data2 1.5s infinite;
}
@-webkit-keyframes alpha-data2 {
0% {
    opacity: 1;
}
50% {
    opacity: 0;
}
100% {
    opacity: 1;
}
}
@keyframes alpha-data2 {
0% {
    opacity: 1;
}
50% {
    opacity: 0;
}
100% {
    opacity: 1;
}
}
.rotate {
  -webkit-animation: rotate-data 1.5s infinite;
          animation: rotate-data 1.5s infinite;
}
@-webkit-keyframes rotate-data {
0% {
    -webkit-transform: rotate(5deg);
            transform: rotate(5deg);
}
50% {
    -webkit-transform: rotate(-5deg);
            transform: rotate(-5deg);
}
100% {
    -webkit-transform: rotate(5deg);
            transform: rotate(5deg);
}
}
@keyframes rotate-data {
0% {
    -webkit-transform: rotate(5deg);
            transform: rotate(5deg);
}
50% {
    -webkit-transform: rotate(-5deg);
            transform: rotate(-5deg);
}
100% {
    -webkit-transform: rotate(5deg);
            transform: rotate(5deg);
}
}
.rotate2 {
  -webkit-animation: rotate-data2 1.5s infinite;
          animation: rotate-data2 1.5s infinite;
}
@-webkit-keyframes rotate-data2 {
0% {
    -webkit-transform: rotate(-5deg);
            transform: rotate(-5deg);
}
50% {
    -webkit-transform: rotate(5deg);
            transform: rotate(5deg);
}
100% {
    -webkit-transform: rotate(-5deg);
            transform: rotate(-5deg);
}
}
@keyframes rotate-data2 {
0% {
    -webkit-transform: rotate(-5deg);
            transform: rotate(-5deg);
}
50% {
    -webkit-transform: rotate(5deg);
            transform: rotate(5deg);
}
100% {
    -webkit-transform: rotate(-5deg);
            transform: rotate(-5deg);
}
}
