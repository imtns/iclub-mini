}
.rule-button  .arrow{
  width:13rpx;
  height:16rpx;
  margin-top: 8rpx;
  animation: arrow-data 1.5s infinite;
}
@keyframes arrow-data{
  0%{  margin-left: 10rpx; }
  50%{  margin-left: 0rpx;}
 100%{  margin-left: 10rpx; }
}
.return-button{
  position:fixed;
  padding:0;
  left: 31rpx;
  margin: auto;
